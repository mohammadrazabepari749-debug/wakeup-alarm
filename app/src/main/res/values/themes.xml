<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WakeUp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.WakeUp.Alarm" parent="Theme.WakeUp">
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:windowKeepScreenOn">true</item>
    </style>
</resources>
